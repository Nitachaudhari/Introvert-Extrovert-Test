# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual Atlas connection string:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/psychometric_assessment_db?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# Frontend URL for CORS configuration (comma-separated for multiple origins if needed)
FRONTEND_URL=http://localhost:5173

# Authentication
# Generate a random secret of at least 32 characters. Never reuse this example value.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# One-time administrator bootstrap (remove after running npm run create-admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
